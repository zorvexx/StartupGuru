# MongoDB Atlas Connection URI
# e.g.: mongodb+srv://<user>:<password>@startupgurucluster.gdfzbrm.mongodb.net/StartupGuru?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/StartupGuru?retryWrites=true&w=majority

# Server Port
PORT=5000

# Express Session Secret
SESSION_SECRET=your_super_secret_session_key

# Node Environment
NODE_ENV=production

# Frontend Client URL (for CORS and session cookies on Vercel)
CLIENT_URL=https://your-frontend.vercel.app
